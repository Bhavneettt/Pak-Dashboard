# ── LLM provider: 'openai' or 'gemini' ───────────────────────
LLM_PROVIDER=openai

# ── OpenAI (if LLM_PROVIDER=openai) ──────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Google Gemini (if LLM_PROVIDER=gemini) ───────────────────
GEMINI_API_KEY=AIza...

# ── NewsAPI fallback (optional) ───────────────────────────────
# Get free key at https://newsapi.org/register
NEWSAPI_KEY=

# ── PHP API base URL ──────────────────────────────────────────
PHP_API_BASE=http://localhost/pak-diplomacy-dashboard/api

# ── Pipeline tuning ───────────────────────────────────────────
LOOKBACK_HOURS=24        # How far back to search for news
MAX_ARTICLES=20          # Max articles to process per run
